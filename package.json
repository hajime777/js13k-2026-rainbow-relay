{
  "name": "js13k-2026-rainbow-relay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite src --host 0.0.0.0 --config vite.config.js",
    "build": "node tools/build.mjs",
    "size": "node tools/build.mjs",
    "seed:forge": "node tools/seed-forge.mjs",
    "test:seed": "node tools/test-seed-length.mjs",
    "test:logic": "node --test tests/logic/*.test.mjs",
    "test:setup": "playwright install chromium",
    "test:ui": "playwright test tests/ui",
    "test:ui:headed": "playwright test tests/ui --headed",
    "test:ui:debug": "playwright test tests/ui --debug",
    "test:all": "npm run test:logic && npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "fflate": "^0.8.2",
    "html-minifier-terser": "^7.2.0",
    "vite": "^7.0.0"
  }
}
